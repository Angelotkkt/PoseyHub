{
  "name": "simply-hub",
  "productName": "Simply Hub",
  "version": "1.0.0",
  "description": "YouTube, Discord, Spotify et tous tes jeux dans une seule appli de bureau — par PoseyDevs",
  "author": "PoseyDevs",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://angelotkkt.github.io/PoseyHub/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Angelotkkt/PoseyHub.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.poseydevs.poseyhub",
    "productName": "Simply Hub",
    "copyright": "© PoseyDevs",
    "electronVersion": "44.9.3+wvcus",
    "electronDownload": {
      "version": "44.9.3+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "./build/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Angelotkkt/PoseyHub/releases/download/windows",
        "channel": "latest"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "SimplyHub-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simply Hub",
      "artifactName": "SimplyHub-Setup.exe"
    }
  }
}
